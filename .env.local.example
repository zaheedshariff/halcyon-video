# Halcyon Video Server Credentials
# Save all your server credentials here so you never have to type them in manually again.
# Vite automatically loads variables from .env.local on application boot.
#
# PUBLIC / RAILWAY HOSTING: do not put the membership password or any shared
# Plex token in this file. HALCYON_SITE_PASSWORD and HALCYON_SITE_FRIENDS are
# server environment variables (see DEPLOY-RAILWAY.md). Anything named VITE_*
# is copied into the JavaScript visitors download.
#
# HOSTING THIS FOR OTHER PEOPLE? Don't use this file for the Jellyseerr/Romm
# keys. Everything VITE_* is INLINED INTO THE BUILT BUNDLE, so every visitor can
# read it out of the JavaScript they download. Set HALCYON_JELLYSEERR_URL /
# HALCYON_JELLYSEERR_APIKEY / HALCYON_ROMM_URL / HALCYON_ROMM_APIKEY in the
# SERVER's environment instead: visitors then arrive already wired up and the
# key never leaves the machine. See README.md → "Running a store for other
# people". This file is the right answer for your own household.

# Jellyfin Media Server (optional auto-login; the app also supports Plex,
# but Plex sign-in uses a plex.tv PIN and has no env-var auto-auth yet)
VITE_JELLYFIN_URL=http://localhost:8096
VITE_JELLYFIN_USERNAME=your_username
VITE_JELLYFIN_PASSWORD=your_password

# Jellyseerr / Overseerr (Optional - for requests & discovery)
# Same API either way. VITE_SEERR_* and VITE_OVERSEERR_* are accepted as
# aliases if you'd rather not name the fork you don't run.
VITE_JELLYSEERR_URL=http://localhost:5055
VITE_JELLYSEERR_APIKEY=your_jellyseerr_api_key

# Romm Video Game Server (Optional - for video games shelf)
VITE_ROMM_URL=http://localhost:8080
VITE_ROMM_APIKEY=your_romm_api_key
